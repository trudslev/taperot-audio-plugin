.DS_Store

# Designer hand-off archives dropped into design/ - the extracted contents are tracked, the
# archive itself is not. design/ itself must stay tracked: assets/2x, fonts/ and icon/ are
# build inputs (juce_add_binary_data and ICON_BIG/ICON_SMALL), so an untracked design/ is a
# repo that does not build.
design/*.zip

# Prompt logs are personal working notes, not project documentation. Any decision that matters
# belongs in a code comment beside what it governs, or in this repo's CLAUDE.md - never only in a
# prompt, where nobody will find it.
prompts/
